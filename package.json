{
  "name": "tomago-backend-nestjs",
  "description": "Tomago Backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:cache": "npm cache clean --force",
    "serve": "firebase serve --only functions",
    "shell": "firebase functions:shell",
    "logs": "firebase functions:log",
    "emulator": "firebase emulators:start --only functions",
    "start": "node server.js",
    "start:development": "cross-env NODE_ENV=development nodemon server.js",
    "start:staging": "cross-env NODE_ENV=staging nodemon server.js",
    "start:production": "cross-env NODE_ENV=production nodemon server.js",
    "debug": "nodemon --inspect ./server.js",
    "test": "nodemon --exec 'cross-env NODE_ENV=test mocha ./src/**/*.test.js --exit || exit 1'",
    "deploy:appengine:development": "gcloud app deploy app-engine.development.yaml --project <insert project id here>",
    "deploy:appengine:staging": "gcloud app deploy app-engine.staging.yaml --project <insert project id here>",
    "deploy:appengine:production": "gcloud app deploy app-engine.production.yaml --project <insert project id here>",
    "predeploy:development": "firebase use development && firebase functions:config:set env.value=\"development\" env.node_env=\"development\"",
    "deploy:development": "npm run predeploy:development && firebase deploy --only functions",
    "predeploy:staging": "firebase use staging && firebase functions:config:set env.value=\"staging\" env.node_env=\"staging\"",
    "deploy:staging": "npm run predeploy:staging && firebase deploy --only functions",
    "predeploy:production": "firebase use production && firebase functions:config:set env.value=\"production\" env.node_env=\"production\"",
    "deploy:production": "npm run predeploy:production && firebase deploy --only functions",
    "deploy:production:v2": "npm run predeploy:production && firebase deploy --only functions:backend-server,storage,database,firestore",
    "deploy": "npm run deploy:cloudrun:production",
    "predeploy:cloudrun:production": "gcloud config set project tomago-fdaa6",
    "deploy:cloudrun:production": "bash ./deploy-cloud-run.sh",
    "predeploy:cloudrun:staging": "gcloud config set project tomago-staging",
    "deploy:cloudrun:staging": "bash ./deploy-cloud-run-staging.sh",
    "deploy:cloudrun:staging:v2": "npm run deploy:cloudrun:staging",
    "seed:firestore": "cross-env NODE_ENV=staging node scripts/seed/index.js",
    "seed:firestore:dry": "cross-env NODE_ENV=staging node scripts/seed/index.js --dry-run",
    "seed:firestore:clear": "cross-env NODE_ENV=staging node scripts/seed/index.js --clear-seed",
    "seed:firestore:auth": "cross-env NODE_ENV=staging node scripts/seed/index.js --with-auth",
    "seed:firestore:emulator": "cross-env NODE_ENV=development node scripts/seed/index.js --use-emulator --with-auth",
    "seed:verify": "node scripts/seed/verify-datasets.js"
  },
  "engines": {
    "node": "20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/runprofdevelopment/tomago-backend-nestjs.git"
  },
  "keywords": [],
  "author": "",
  "license": "",
  "dependencies": {
    "@google-cloud/logging": "^11.0.0",
    "@google-cloud/pubsub": "^4.5.0",
    "@google-cloud/tasks": "^5.5.0",
    "@shopify/shopify-api": "^7.2.0",
    "axios": "^0.21.4",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "colors": "^1.4.0",
    "cors": "2.8.5",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.13",
    "dayjs-plugin-utc": "^0.1.2",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-graphql": "0.7.1",
    "firebase": "^9.14.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.1",
    "form-data": "^4.0.0",
    "generate-password": "^1.7.0",
    "geofire-common": "^5.2.0",
    "google-auth-library": "^9.14.0",
    "google-libphonenumber": "^3.2.34",
    "graphql": "^14.7.0",
    "graphql-fields": "2.0.1",
    "graphql-iso-date": "3.6.1",
    "graphql-subscriptions": "^1.2.1",
    "graphql-tools": "4.0.4",
    "graphql-type-json": "0.2.1",
    "graphql-upload": "^13.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^4.4.1",
    "jsonwebtoken": "^9.0.2",
    "loading-spinner": "^1.2.1",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.6",
    "nodemailer": "^6.6.3",
    "qrcode": "^1.5.3",
    "qs": "^6.13.0",
    "sharp": "^0.33.5",
    "underscore": "^1.13.7",
    "uuid": "^8.3.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "firebase-functions-test": "0.2.1",
    "mocha": "^11.8.0",
    "node-mocks-http": "1.7.3",
    "nodemon": "^3.0.3"
  }
}
