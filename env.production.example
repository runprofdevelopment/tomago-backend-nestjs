# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=8080

# Firebase Configuration
FIREBASE_PROJECT_ID=decoopa-50ce2
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@decoopa-50ce2.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40decoopa-50ce2.iam.gserviceaccount.com

# Algolia Configuration
ALGOLIA_APPLICATION_ID=your_algolia_app_id
ALGOLIA_ADMIN_API_KEY=your_algolia_admin_key
ALGOLIA_SEARCH_ONLY_API_KEY=your_algolia_search_key
PRODUCTS_INDEX=PRODUCTS
CATEGORIES_INDEX=CATEGORIES

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# API Configuration
API_KEY=your_api_key_here
GRAPHQL_ENDPOINT=/graphql

# Database Configuration (if using external database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=decoopa_production
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Cloud Storage Configuration
GOOGLE_CLOUD_PROJECT=decoopa-50ce2
GOOGLE_CLOUD_STORAGE_BUCKET=decoopa-production-bucket

# Logging Configuration
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Security Configuration
CORS_ORIGIN=https://your-frontend-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SMS_VERIFICATION=true
ENABLE_ALGOLIA_SEARCH=true 